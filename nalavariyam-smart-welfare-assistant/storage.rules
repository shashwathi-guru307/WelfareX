rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Case documents — authenticated users only
    match /case_documents/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}