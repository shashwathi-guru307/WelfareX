# ============================================================
# Nalavariyam Smart Welfare Assistant — Environment Variables
# ============================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit .env files to version control.
# ============================================================

# ============================================================
# Backend Configuration
# ============================================================
FLASK_DEBUG=0
PORT=5000
LOG_LEVEL=INFO

# ============================================================
# Security (REQUIRED for production)
# ============================================================
# Generate a strong random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ============================================================
# Database
# ============================================================
# Development: SQLite (default, no configuration needed)
DATABASE_PATH=../database/nalavariyam.db

# Production: PostgreSQL (uncomment and configure)
# DATABASE_URL=postgresql://username:password@host:5432/nalavariyam

# ============================================================
# CORS & Frontend
# ============================================================
# Development (default)
FRONTEND_URL=http://localhost:5173

# Production — set to your deployed frontend URL
# FRONTEND_URL=https://your-app.vercel.app

# ============================================================
# Document Storage
# ============================================================
# Development: local filesystem (default)
DOCUMENT_STORAGE_PATH=../uploads/case_documents

# Production: use persistent storage path
# DOCUMENT_STORAGE_PATH=/var/data/nwsa/documents

# ============================================================
# Authorized User Accounts (used by init_users.py)
# ============================================================
# Change these before first deployment!
ADMIN_EMAIL=rselva1204@gmail.com
ADMIN_PASSWORD=selva1204
ADMIN_NAME=Administrator
ADMIN_USERNAME=rselva1204

STAFF_EMAIL=thorfinn@example.com
STAFF_PASSWORD=thorfinn1204
STAFF_NAME=Staff User
STAFF_USERNAME=thorfinn

# ============================================================
# Frontend (Vite)
# ============================================================
# Set in frontend/.env.local or frontend/.env.production
# VITE_API_URL=/api                    # default (relative, for same-origin deployment)
# VITE_API_URL=https://your-api.vercel.app/api  # cross-origin backend
