# ============================================================
# Nalavariyam Smart Welfare Assistant — Environment Variables
# ============================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit .env files to version control.
# ============================================================

# ============================================================
# Backend Configuration
# ============================================================
FLASK_DEBUG=0
PORT=5000
LOG_LEVEL=INFO

# ============================================================
# Security (REQUIRED for production)
# ============================================================
# Generate a strong random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ============================================================
# Database
# ============================================================
# Development: SQLite (default, no configuration needed)
DATABASE_PATH=../database/nalavariyam.db

# Production: PostgreSQL (uncomment and configure)
# DATABASE_URL=postgresql://username:password@host:5432/nalavariyam

# ============================================================
# CORS & Frontend
# ============================================================
# Development (default)
FRONTEND_URL=http://localhost:5173

# Production — set to your deployed frontend URL
# FRONTEND_URL=https://your-app.vercel.app

# ============================================================
# Document Storage
# ============================================================
# Development: local filesystem (default)
DOCUMENT_STORAGE_PATH=../uploads/case_documents

# Production: use persistent storage path
# DOCUMENT_STORAGE_PATH=/var/data/nwsa/documents

# ============================================================
# Authorized User Accounts (used by init_users.py)
# ============================================================
# Change these BEFORE first deployment!
# These are placeholder values — replace with your own.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin

STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD
STAFF_NAME=Staff User
STAFF_USERNAME=staff

# ============================================================
# Google OAuth (Optional — for Google Sign-In)
# ============================================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID for Web Application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For Google Sign-In with GSI, redirect is 'postmessage'
GOOGLE_REDIRECT_URI=postmessage

# ============================================================
# SMS Notifications (Twilio)
# ============================================================
# Get these from https://console.twilio.com/
# You need a Twilio account + a phone number for sending SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Example TWILIO_PHONE_NUMBER=+1234567890
# Indian numbers must be in E.164 format: +91XXXXXXXXXX

# ============================================================
# Frontend (Vite)
# ============================================================
# Set in frontend/.env.local or frontend/.env.production
# VITE_API_URL=/api                    # default (relative, for same-origin deployment)
# VITE_API_URL=https://your-api.vercel.app/api  # cross-origin backend
